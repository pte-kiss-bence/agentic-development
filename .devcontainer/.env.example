# Copy this file to .devcontainer/.env and fill in your values:
#   cp .devcontainer/.env.example .devcontainer/.env
#
# The real .env is git-ignored, so your secrets never get committed.
# This file is loaded into the dev container via `runArgs: --env-file`
# in devcontainer.json, so every KEY=VALUE here becomes an environment
# variable inside the container.
#
# IMPORTANT:
#   - Values must NOT be quoted (docker --env-file takes the value literally).
#   - Only full-line `# comments` are allowed, not inline ones.
#   - After editing, run "Dev Containers: Rebuild Container" to apply.

# Git commit identity. The PAT only authenticates to GitHub; git still needs an
# author name/email to create commits. post-create.sh applies these via
# `git config` on every container build, so they survive rebuilds.
GIT_USER_NAME=
GIT_USER_EMAIL=

# GitHub Personal Access Token for the GitHub MCP server.
# Create one at https://github.com/settings/tokens
# (fine-grained with repo access, or classic with the "repo" scope).
GITHUB_PERSONAL_ACCESS_TOKEN=

# Context7 (Upstash) API key for the documentation lookup MCP server.
# OPTIONAL: context7 also works without a key (lower rate limits). Leave this
# empty to stay in keyless mode - only set a *real* key, because an invalid
# value gets rejected and would break the server.
# Create one at https://context7.com/dashboard
CONTEXT7_API_KEY=